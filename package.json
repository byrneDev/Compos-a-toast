{
  "name": "compos-a-toast",
  "version": "0.5.0",
  "private": true,
  "description": "A desktop migration workbench for extracting legacy Composica courses into editable bundles, HTML5 SCORM 1.2 packages, and editable-text Captivate drafts.",
  "main": "./out/main/index.js",
  "type": "module",
  "author": "Compos-a-toast contributors",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.9.0",
  "keywords": [
    "composica",
    "captivate",
    "scorm",
    "elearning",
    "electron"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "start": "npm run build && electron .",
    "build": "npm run typecheck && electron-vite build && node scripts/verify-build.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:local-courses": "vitest run --config vitest.local.config.ts",
    "test:captivate-live": "set COMPOS_A_TOAST_RUN_CAPTIVATE_LIVE=1&& vitest run --disableConsoleIntercept --config vitest.captivate.config.ts",
    "clean:release": "node scripts/clean-release.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:windows-installer": "node scripts/verify-windows-installer.mjs",
    "package": "npm run clean:release && npm run build && electron-builder --dir -c.forceCodeSigning=true && npm run verify:package",
    "package:unsigned": "npm run clean:release && npm run build && electron-builder --dir && npm run verify:package",
    "package:win": "npm run clean:release && npm run build && electron-builder --win nsis --x64 -c.forceCodeSigning=true && npm run verify:package && npm run verify:windows-installer",
    "package:win:unsigned": "npm run clean:release && npm run build && electron-builder --win nsis --x64 && npm run verify:package && npm run verify:windows-installer"
  },
  "build": {
    "appId": "com.composatoast.desktop",
    "productName": "Compos-a-toast",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/core/captivate/classic-11.8.4-driver.ps1",
        "to": "captivate/classic-11.8.4-driver.ps1"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "selectPerMachineByDefault": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "buildUniversalInstaller": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Compos-a-toast",
      "menuCategory": false,
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "license": "LICENSE",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "uninstallDisplayName": "${productName} ${version} (64-bit)"
    }
  },
  "dependencies": {
    "adm-zip": "0.6.0",
    "fast-xml-parser": "5.10.1",
    "htmlparser2": "12.0.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@playwright/test": "1.62.1",
    "@types/adm-zip": "0.5.8",
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
